<div class="container mt-5">
    <h1>Character Aggregator</h1>

    <form id="animeForm" onsubmit="sendAnimeRequest(); return false;">
        <div class="mb-3">
            <label for="animeName" class="form-label">Character Name</label>
            <input name = "name" type="text" class="form-control" id="animeName" placeholder="Enter character name" required>
        </div>
        <button type="submit" >Search</button>
    </form>

    <form id="personForm" onsubmit="sendPersonRequest(); return false;">
        <div class="mb-3">
            <label for="personName" class="person-label">Person Name</label>
            <input name = "name" type="text" class="form-control" id="personName" placeholder="Enter person name" required>
        </div>
        <button type="submit" >Search</button>
    </form>
</div>

