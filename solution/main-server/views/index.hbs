<head>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<div class="header">
    <h1>Anime Search</h1>
    <p>Discover your favorite anime, characters, and people</p>
</div>

<div class="container-index">
    <div class="search-card">
        <div class="mb-3">
            <label for="searchType" class="form-label">Search type</label>
            <select id="searchType" class="form-select">
                <option value="anime" selected>Anime</option>
                <option value="character">Character</option>
                <option value="person">Person</option>
                <option value="user">User</option>
            </select>
        </div>

    <form id="form-anime" action="/details/title" method="POST">
        <div class="mb-3">
            <label for="searchInput" class="form-label">Name</label>

            <input type="text" name="detailsName" id="detailsName" placeholder="Enter Anime name" class="form-control">
        </div>
        <button type="submit"  class="btn btn-primary">Search Anime</button>

    </form>

    <form id="form-character" action="/characters/name" method="POST" style="display:none">
        <div class="mb-3">
            <label for="searchInput" class="form-label">Name</label>

            <input type="text" name="animeName" id="animeName" placeholder="Enter Character name" class="form-control">
        </div>
        <button type="submit"  class="btn btn-primary">Search Character</button>

    </form>

    <form id="form-person" action="/personDetails/name" method="POST" style="display:none">
        <div class="mb-3">
            <label for="searchInput" class="form-label">Name</label>

            <input type="text" name="personName" id="personName" placeholder="Enter Person name" class="form-control">
        </div>
        <button type="submit"  class="btn btn-primary">Search Person</button>

    </form>

    <form id="form-user" onsubmit="sendUserRequest(); return false;" style="display:none">
        <div class="mb-3">
            <label for="searchInput" class="form-label">Name</label>
            <input type="text" class="form-control" id="searchInput" placeholder="Enter User name" required>
        </div>
        <button type="submit" class="btn btn-primary">Search User</button>
    </form>

    {{#if error}}
        <div class="alert alert-danger text-center">
            {{error}}
        </div>
    {{/if}}
</div>
</div>
</div>
</div>
</body>
    <script src="/javascripts/index.js" defer></script>

</body>
