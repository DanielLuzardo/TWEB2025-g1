<head>
    <link rel="stylesheet" href="/stylesheets/details.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<div class="container mt-4">

    <div class="details-header">
        <img src="{{details.imageUrl}}" alt="{{details.title}}">
        <div class="details-info">
            <h1>
                {{details.title}}
                {{#if details.titleJapanese}}
                    ({{details.titleJapanese}})
                {{/if}}
            </h1>
            <p class="details-anime">
                <span>Anime Type: {{details.type}}</span>
                <span>Episodes: {{details.episodes}}</span>
                <span>Year: {{details.year}}</span>
                <span>Popularity: {{details.popularity}}</span>
                <span>Rating: {{details.rating}}</span>
            </p>
            <p>{{details.synopsis}}</p>
            <p>URL: <a href="{{details.url}}" target="_blank">{{details.url}}</a></p>
        </div>
    </div>

    {{#if stats}}
        <div class="stats-section">
            <h2>User Statistics</h2>
            <div class="stats-grid">
                <div class="stat-item">
                    <span class="stat-label">Watching</span>
                    <span class="stat-value">{{stats.watching}}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Completed</span>
                    <span class="stat-value">{{stats.completed}}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">On Hold</span>
                    <span class="stat-value">{{stats.on_hold}}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Dropped</span>
                    <span class="stat-value">{{stats.dropped}}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Plan to Watch</span>
                    <span class="stat-value">{{stats.plan_to_watch}}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Total</span>
                    <span class="stat-value">{{stats.total}}</span>
                </div>
            </div>
        </div>
    {{/if}}

    {{#if recommendations.length}}
        <div class="recommendations-section">
            <h2>Recommendations</h2>
            <div class="recommendations-list">
                {{#each recommendations}}
                    <a href="/details/{{this.recommendation_mal_id}}" class="recommendation-item">
                        Anime #{{this.recommendation_mal_id}}
                    </a>
                {{/each}}
            </div>
        </div>
    {{/if}}
    {{#if charactersAnime}}
        <h3>Characters</h3>
        <div class="characters-list">
            {{#each charactersAnime}}
                <a href="/characters/{{id}}" class="character-link">
                    <div class="character-item">
                        <img src="{{imageUrl}}" alt="{{name}}">
                        <p><strong>{{name}}</strong></p>
                    </div>
                </a>
            {{/each}}
        </div>
    {{/if}}
</div>
</body>