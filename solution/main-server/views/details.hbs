<head>
    <link rel="stylesheet" href="/stylesheets/details.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

</head>
<body>
<div class="container mt-4">
    <div class="details-header">
        <img src="{{details.imageUrl}}" alt="{{details.title}}">
        <div class="details-info">
            <h1>
                {{details.title}}
                {{#if details.titleJapanese}}
                    ({{details.titleJapanese}})
                {{/if}}
            </h1>
            <p class="details-anime">
                {{#if details.type}}<span>Anime Type: {{details.type}}</span>{{/if}}
                {{#if details.episodes}}<span>Episodes: {{details.episodes}}</span>{{/if}}
                {{#if details.year}}<span>Year: {{details.year}}</span>{{/if}}
                {{#if details.popularity}}<span>Popularity: {{details.popularity}}</span>{{/if}}
                {{#if details.rating}}<span>Rating: {{details.rating}}</span>{{/if}}
            </p>
            <div class="stats-section-bottom">
                <div class="stats-cards">
                    <div class="stat-card">
                        <span class="stat-title">SCORE</span>
                        <span class="stat-main">{{details.score}}</span>
                        <span class="stat-sub">{{details.scoredBy}} users</span>
                    </div>
                    {{#if details.rank}}
                        <div class="stat-card">
                            <span class="stat-title">RANKED</span>
                            <span class="stat-main">#{{details.rank}}</span>
                        </div>
                    {{/if}}
                    {{#if details.popularity}}
                        <div class="stat-card">
                            <span class="stat-title">POPULARITY</span>
                            <span class="stat-main">#{{details.popularity}}</span>
                        </div>
                    {{/if}}
                    {{#if details.members}}
                        <div class="stat-card members-card">
                            <span class="stat-title">MEMBERS</span>
                            <span class="stat-main">{{details.members}}</span>
                        </div>
                    {{/if}}

                </div>
            </div>
            <h3>Synopsis</h3>
            <p>{{details.synopsis}}</p>
            <p>
                <strong>
                    <a href="{{details.url}}" target="_blank">View on MyAnimeList</a>
                </strong>
            </p>
        </div>
    </div>

    {{#if stats}}
        <div class="stats-section">
            <h2>User Statistics</h2>
            <div class="stats-grid">
                <div class="stat-item">
                    <span class="stat-label">Watching</span>
                    <span class="stat-value">{{stats.watching}}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Completed</span>
                    <span class="stat-value">{{stats.completed}}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">On Hold</span>
                    <span class="stat-value">{{stats.on_hold}}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Dropped</span>
                    <span class="stat-value">{{stats.dropped}}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Plan to Watch</span>
                    <span class="stat-value">{{stats.plan_to_watch}}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Total</span>
                    <span class="stat-value">{{stats.total}}</span>
                </div>
            </div>
        </div>
    {{/if}}
    <div class="tabs-container">
        <button class="tab-btn {{#if charactersAnime}}active{{else}}disabled{{/if}}"
                id="btn-chars"
                type="button"
                {{#unless charactersAnime}}disabled{{/unless}}>
            Characters
        </button>
        <button class="tab-btn {{#if charactersAnime}}{{else}}active{{/if}} {{#unless recommendations.length}}disabled{{/unless}}"
                id="btn-recs"
                type="button"
                {{#unless recommendations.length}}disabled{{/unless}}>
            Recommendations
        </button>
    </div>
    {{#if recommendations.length}}
        <div id="recs"  style="display:none;">
            <section class="recommendations-section">
                <h2 class="section-title">Recommendations</h2>
                <div class="recommendations-list-vertical">
                    {{#each recommendations}}
                        <a href="/details/{{this.recommendation_mal_id}}" class="rec-row">
                            <div class="rec-thumb">
                                <img src="{{this.anime.imageUrl}}" alt="{{this.anime.title}}">
                            </div>
                            <div class="rec-info">
                                <div class="rec-title">
                                    {{#if this.anime.title}}
                                        {{this.anime.title}}
                                    {{/if}}
                                </div>

                            </div>
                        </a>
                    {{/each}}
                </div>
            </section>
        </div>
    {{/if}}

    {{#if charactersAnime}}
        <div id="chars">
            <section class="recommendations-section">
            <h2 class="section-title" >Characters</h2>
            <div class="characters-list-2col">
                {{#each charactersAnime}}
                    <a href="/characters/{{id}}" class="character-row">
                        <div class="character-thumb">
                            <img src="{{imageUrl}}" alt="{{name}}" onerror="this.src='/images/default-character.png'">
                        </div>
                        <div class="character-info">
                            <div class="character-name">
                                {{name}}
                            </div>
                        </div>
                    </a>
                {{/each}}
            </div>
            </section>
        </div>
    {{/if}}

</div>

<script src="/javascripts/details.js" defer></script>

</body>


