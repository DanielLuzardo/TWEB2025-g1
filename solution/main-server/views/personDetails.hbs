<head>
    <link rel="stylesheet" href="/stylesheets/personDetails.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<div class="container mt-4">

    <div class="person-header">
        <img src="{{person.imageUrl}}" alt="{{person.name}}">
        <div class="person-info">
            <h1>
                {{person.name}}
                {{#if person.givenName}}
                    ({{person.givenName}})
                {{/if}}
            </h1>
            <p>Birthday: {{person.birthdayFormatted}}</p>
            <p>URL: <a href="{{person.url}}" target="_blank">{{person.url}}</a></p>
        </div>
    </div>
    {{#if animeWorks}}
        <h3>Anime works</h3>
        <div class="anime-list">
            {{#each animeWorks}}
                <a href="/details/{{id.animeMalId}}">
                    <div class="anime-item">
                        {{#if anime}}
                            <img src="{{anime.imageUrl}}" alt="{{anime.title}}">
                            <p><strong>{{anime.title}}</strong></p>
                        {{else}}
                            <div>
                                <p>No image</p>
                            </div>
                        {{/if}}
                        <p>Positison: {{id.position}}</p>

                    </div>
                </a>
            {{/each}}
        </div>
    {{/if}}
    {{#if voiceWorks}}
        <h3>Voice works</h3>
        <div class="voice-list">
            {{#each voiceWorks}}
                <div class="voice-item">
                    <a href="/details/{{id.animeMalId}}" class="anime-link">
                        {{#if voice}}
                            <img src="{{voice.imageUrl}}" alt="{{voice.title}}">
                            <p><strong>{{voice.title}}</strong></p>
                        {{else}}
                            <div class="no-image">
                                <p>No image</p>
                            </div>
                        {{/if}}
                        <p>Role: {{role}}</p>
                        <p>Language: {{language}}</p>
                    </a>

                    <a href="/characters/{{id.characterMalId}}" class="character-link">
                        <p>Character: {{characterName}}</p>
                    </a>
                </div>
            {{/each}}
        </div>
    {{/if}}







</div>
</body>
</html>
