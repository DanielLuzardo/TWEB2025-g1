<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{character.name}}</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/characterDetails.css">

</head>
<body>
<div class="container mt-4">

    <div class="character-header">
        <img src="{{character.image}}" alt="{{character.name}}">
        <div class="character-info">
            <h1>
                {{character.name}}
                {{#if character.nameKanji}}
                    ({{character.nameKanji}})
                {{/if}}
            </h1>
            <p>{{character.about}}</p>
            <p>URL: <a href="{{character.url}}" target="_blank">{{character.url}}</a></p>
        </div>
    </div>

    {{#if animeWorks}}
        <h3>Anime works</h3>
        <div class="anime-list">
            {{#each animeWorks}}
                <a href="/animes/{{id.animeMalId}}">
                    <div class="anime-item">
                        {{#if anime}}
                            <img src="{{anime.imageUrl}}" alt="{{anime.title}}">
                            <p><strong>{{anime.title}}</strong></p>
                        {{else}}
                            <div style="width: 100%; height: 200px; background: #444; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                <p>No image</p>
                            </div>
                        {{/if}}
                        <p>Character: {{characterName}}</p>
                        <p>Role: {{role}}</p>
                    </div>
                </a>
            {{/each}}
        </div>
    {{/if}}



    {{#if voiceActors}}
        <h3>Voice Actors</h3>
        <div class="anime-list">
            {{#each voiceActors}}
                <div class="anime-item">
                    {{#if person}}
                        <img src="{{person.imageUrl}}" alt="{{person.name}}">
                        <p><strong>{{person.name}}</strong></p>
                    {{/if}}
                    <p>Role: {{role}}</p>
                    <p>Language: {{language}}</p>
                </div>
            {{/each}}
        </div>
    {{/if}}


    {{#if character.nicknames}}
        <h3>Nicknames</h3>
        <ul>
            {{#each character.nicknames}}
                <li>{{this.nickname}}</li>
            {{/each}}
        </ul>
    {{/if}}

</div>
</body>
</html>
