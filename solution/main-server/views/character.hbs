<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{character.name}}</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #1a1a2e;
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
        }
        .character-header {
            display: flex;
            gap: 20px;
            background-color: #2e2e50;
            padding: 20px;
            border-radius: 10px;
        }
        .character-header img {
            width: 400px;
            height: 400px;
            border-radius: 10px;
        }
        .character-info h1 {
            margin-bottom: 10px;
            color: #b084f5;
        }
        .anime-list {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding: 10px 0;
            gap: 30px;
        }

        .anime-item {
            width: 200px;
            height: 280px;
            text-align: center;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }
        .anime-item img {
            width: 200px;
            height: 200px;
            border-radius: 10px;
            object-fit: cover;
        }
        .anime-item p {
            color: white;
            margin-top: 5px;
            margin-bottom: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            transition: color 0.3s ease;
        }

        a:hover .anime-item p {
            color: #b084f5;
        }

        a {
            color: #4dabf7;
            text-decoration: none;
        }

        h3 {
            margin-top: 30px;
            margin-bottom: 10px;
            color: #b084f5;
        }
        ul {
            list-style-type: none;
            color: #ffffff;
        }

    </style>
</head>
<body>
<div class="container mt-4">

    <div class="character-header">
        <img src="{{character.image}}" alt="{{character.name}}">
        <div class="character-info">
            <h1>
                {{character.name}}
                {{#if character.nameKanji}}
                    ({{character.nameKanji}})
                {{/if}}
            </h1>
            <p>{{character.about}}</p>
            <p>URL: <a href="{{character.url}}" target="_blank">{{character.url}}</a></p>
        </div>
    </div>

    {{#if animeWorks}}
        <h3>Anime works</h3>
        <div class="anime-list">
            {{#each animeWorks}}
                <a href="/animes/{{id.animeMalId}}">
                    <div class="anime-item">
                        {{#if anime}}
                            <img src="{{anime.imageUrl}}" alt="{{anime.title}}">
                            <p><strong>{{anime.title}}</strong></p>
                        {{else}}
                            <div style="width: 100%; height: 200px; background: #444; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                <p>No image</p>
                            </div>
                        {{/if}}
                        <p>Character: {{characterName}}</p>
                        <p>Role: {{role}}</p>
                    </div>
                </a>
            {{/each}}
        </div>
    {{/if}}



    {{#if voiceActors}}
        <h3>Voice Actors</h3>
        <div class="anime-list">
            {{#each voiceActors}}
                <div class="anime-item">
                    {{#if person}}
                        <img src="{{person.imageUrl}}" alt="{{person.name}}">
                        <p><strong>{{person.name}}</strong></p>
                    {{/if}}
                    <p>Role: {{role}}</p>
                    <p>Language: {{language}}</p>
                </div>
            {{/each}}
        </div>
    {{/if}}


    {{#if character.nicknames}}
        <h3>Nicknames</h3>
        <ul>
            {{#each character.nicknames}}
                <li>{{this.nickname}}</li>
            {{/each}}
        </ul>
    {{/if}}

</div>
</body>
</html>
